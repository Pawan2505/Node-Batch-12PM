<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Product</title>
</head>
<body>
    <h1>Product Details</h1>
   <% product.forEach(function(product) { %>
        <div>
            <h2><%= product.name %></h2>
            <p>Price: $<%= product.price %></p>
            <a href="/edit-product/<%= product.id %>"><button>Edit</button></a>
            <a href="/delete-product/<%= product.id %>"><button>Delete</button></a>
        </div>
    <% }); %>
</body>
</html>